{
  "_comments": {
    "setup": "CLIENT SETUP - Local-la Run Panuvathu Eppadi?",
    "step1": "cd restaurant-erp/client",
    "step2": "npm install",
    "step3": "npm run dev - Frontend 5173 port-la run aakum",
    "step4": "Browser-la: http://localhost:5173 open pannu",
    "note": "Backend (server) 5000 port-la running irundhu thanda"
  },
  "name": "client",
  "version": "0.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.rms.restaurant",
    "productName": "RMS Restaurant ERP",
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "socket.io-client": "^4.8.3"
  }
}
